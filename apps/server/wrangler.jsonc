{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wabbr-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "GameRoom", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true },
  "vars": {
    // Orígenes permitidos para conectarse, separados por coma.
    // En producción poné acá tu dominio de Vercel. Vacío = permitir todo (solo dev).
    "ALLOWED_ORIGINS": "",
    // Región donde se crea el Durable Object: sam (Sudamérica), enam, wnam,
    // weur, eeur, apac, oc, afr, me. Vacío = cerca del primero que entra.
    "DO_LOCATION_HINT": "sam"
  }
}
